{
  "name": "d-bee",
  "private": true,
  "version": "1.7.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:native": "vite build --mode native-release",
    "build:native:internal": "vite build --mode native-internal",
    "typecheck": "tsc --noEmit",
    "test:iap": "vitest run tools/iap-checkout.test.ts && node tools/iap-selftest.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "start": "npm run build && vite preview --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "native:sync": "npm run build:native && cap sync",
    "native:sync:internal": "npm run build:native:internal && cap sync",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run build:native && cap sync ios && cap open ios",
    "postinstall": "cd packages/shared && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-wechat": "^8.0.52",
    "@dbee/health": "file:native-plugins/dbee-health",
    "@dbee/iap": "file:native-plugins/dbee-iap",
    "@dbee/origin-proxy": "file:native-plugins/dbee-origin-proxy",
    "@dbee/shared": "file:packages/shared",
    "@tencent-ai/workbuddy-cloud-sdk": "dev",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
