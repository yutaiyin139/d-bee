{
  "name": "d-bee",
  "private": true,
  "version": "1.6.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "start": "npm run build && vite preview --host 0.0.0.0 --port ${PORT:-3000} --strictPort",
    "native:sync": "npm run build && cap sync",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-wechat": "^8.0.52",
    "@dbee/health": "file:native-plugins/dbee-health",
    "@dbee/iap": "file:native-plugins/dbee-iap",
    "@dbee/origin-proxy": "file:native-plugins/dbee-origin-proxy",
    "@tencent-ai/workbuddy-cloud-sdk": "dev",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zxing-wasm": "^3.1.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
