# 复制本文件为 keystore.properties（已被 .gitignore 排除，严禁提交真实密码）
# keystore 文件放 android/keys/ 下（同样被 .gitignore 排除）
#
# 生成命令示例（有效期 30 年）：
#   keytool -genkeypair -v -keystore keys/dbee-release.keystore -alias dbee \
#     -keyalg RSA -keysize 2048 -validity 10950 -dname "CN=D-Bee, OU=Mobile, O=D-Bee, L=Shenzhen, ST=Guangdong, C=CN"
#
# ⚠️ keystore 丢失 = 已发布 App 永远无法覆盖更新，务必备份到安全位置。
storeFile=keys/dbee-release.keystore
storePassword=CHANGE_ME
keyAlias=dbee
keyPassword=CHANGE_ME
