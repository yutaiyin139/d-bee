node_modules/
dist/
*.local
.env
.env.*
!.env.example
.DS_Store

# Python 编译缓存（py_compile / import 产物）
__pycache__/
*.py[cod]

# 凭据与备份数据不入库
db/CREDENTIALS.txt
db/backups/

# 含真实用户数据的镜像 SQL 不入库（PIPL 最小必要）：
# 0030-full-selfhost-mirror.sql 内含全量用户健康档案（年龄/身高体重/饮食记录，含未成年人）。
# 入库的是 --schema-only 产物 db/migrations/0030-schema.sql（纯结构，0 行数据）。
# 需要带数据的镜像时本地重新生成：python db/gen-full-mirror-sql.py
db/migrations/0030-full-selfhost-mirror.sql
db/migrations/0002-mirror-to-local-pg.sql
design/icon/_check/
design/icon/backup-public/
design/icon/preview/
deploy/screenshots/

# 自检脚本的编译产物（源码 tools/insight-selftest.ts）
tools/.insight-selftest.mjs

# Vite 配置文件变更时生成的临时文件
vite.config.ts.timestamp-*.mjs

# 发布归档包（体积大，含凭据，不入库）
backups/

# 本地交付的 APK / 发布产物（不入库，跨机从 git 源码重建）
dist-release/

# WorkBuddy 本地运行产物（memory/ 保留，跨机保留工作上下文；tmp/ 是草稿，不入库）
.workbuddy/tmp/

# cap sync 守卫绕行时临时移出的原生目录（不 repairs 入库）
.cap-tmp/

# 文档流水线中间产物（最终 .docx 交付后保留在本地，不入库）
output/

# 原生插件的 Gradle 构建产物不入库
native-plugins/*/android/build/
native-plugins/*/android/.gradle/
native-plugins/*/ios/DerivedData/

# 发布产物（APK/AAB 等）本地留存，不入库
release/
