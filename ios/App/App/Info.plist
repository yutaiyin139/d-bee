<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<!--
	  🔴 必须与 capacitor.config.ts:26 的 appName 逐字一致（「自律蜜蜂」），
	     也必须与 ASC 上的 App 名称、工信部 App 备案名一致 —— 三处任一不一致
	     都会在填备案号时触发 409 ICP_NUMBER_MIIT_APP_NAME_MISMATCH，或被审核
	     以「二进制显示名与商店名不符」打回（Guideline 2.3.7）。
	  ⚠️ 改本 plist **不会**被 `cap sync` 写回；但改 capacitor.config.ts 的
	     appName **会**在下次 sync 时覆盖此处 → 两边必须同步改。
	-->
	<key>CFBundleDisplayName</key>
        <string>自律蜜蜂</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!--
	  出口合规声明：本 App 仅使用 HTTPS（属豁免范围），未实现任何非豁免的加密算法。
	  显式声明为 false，可免去每次上传 App Store Connect 时的手动回答。
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
	  微信开放平台「移动应用」接入配置（配套代码见 src/lib/wechat.ts）。

	  🔴 2026-11-22 已删除 CFBundleURLTypes 里的微信占位 scheme（原值
	     CFBundleURLName=weixin + wx0000000000000000）。原因：注册一个**假 AppID**
	     的 URL scheme 属审核疑点（Guideline 2.1 / 2.3.1「声明了却不可用的集成」），
	     且 iOS 侧微信登录当前未启用。将来真接微信开放平台时，须填真实 AppID 后
	     再把整个 CFBundleURLTypes dict 加回来，并在 Xcode 开启 Associated Domains
	     （applinks:<已备案域名>）+ 在该域名放 apple-app-site-association。

	  ✅ 保留下面的 LSApplicationQueriesSchemes —— 它只是「允许 canOpenURL 查询
	     微信是否已安装」，不注册任何 scheme，不含占位凭据，不构成审核疑点。
	     缺 weixin 会被 iOS 判定为「未安装微信」，缺 weixinULAPI 则 Universal Link
	     回跳会失效。
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>weixin</string>
		<string>weixinULAPI</string>
		<string>weixinURLParamsAPI</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!--
	  隐私用途说明（App Store 审核强制要求）。
	  缺失的后果不是「弹窗文案难看」，而是 iOS 在 App 请求该权限时**直接终止进程**。
	  文案必须说明**具体用途**——笼统表述（如「需要相机权限」）会被审核以 5.1.1 打回。

	  对应功能与代码位置：
	    - 相机 · 扫码：Web 端 getUserMedia + zxing 识别食品条码（src/lib/scan.ts）
	    - 相机 · 拍照：Web 端 <input capture> 拍摄餐食照片（src/lib/capture.ts）
	    - 相册 · 读取：从相册选择已有餐食照片

	  ⚠️ 未声明 NSMicrophoneUsageDescription —— 本 App 不录音，多声明反而会被审核追问。
	  ⚠️ 若阶段 2 接入 @capacitor/camera 的 saveToGallery（保存到相册），
	     需另行补 NSPhotoLibraryAddUsageDescription。
	-->
	<key>NSCameraUsageDescription</key>
	<string>自律蜜蜂需要使用相机，用于扫描食品包装上的条码、以及拍摄你这一餐的照片，以便自动识别食物并估算热量。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>自律蜜蜂需要访问相册，用于选择你已拍摄的餐食照片，以便识别食物并估算热量。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>自律蜜蜂需要将识别结果截图或餐食记录保存到你的相册，方便你随时回顾。</string>
	<key>NSHealthShareUsageDescription</key>
	<string>自律蜜蜂需要读取你的步数与活动能量，用于自动计入每日活动消耗，更准确地计算热量缺口。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>自律蜜蜂需要写入健康数据，用于同步你的运动记录。</string>

	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<!--
		  原值 armv7 是 Capacitor/Cordova 模板遗留的 32 位声明（iOS 11 起系统已无 32 位）。
		  本工程产物是 arm64-only，声明 armv7 会导致 App Store 的机型兼容性判定与实际
		  二进制不一致，出现过「商店显示不兼容 / 无法安装」的案例。改为 arm64 与构建产物对齐。
		-->
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
