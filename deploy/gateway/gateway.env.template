# ═══════════════════════════════════════════════════════════════════════
# D-Bee 网关 · 生产环境变量模板
# ═══════════════════════════════════════════════════════════════════════
# 渲染方：deploy/deploy-gateway.sh（本地 sed 替换后上传为 /etc/dbee/gateway.env）
# 消费方：systemd 的 EnvironmentFile=（dbee-gateway.service）
#
# ⚠️ 本模板入库、不含秘密。渲染产物含全部密钥，**不入库**（.gitignore 已覆盖 .env*）。
# ⚠️ 服务器上落盘为 /etc/dbee/gateway.env，权限 0640 root:dbee。
#
# 命名与 server/lib/config.mjs 的 loadConfig() 逐一对应；改这里前先改那里。
# ═══════════════════════════════════════════════════════════════════════

# ── 运行模式 ──────────────────────────────────────────────────────────
# 模板默认**不设** DBEE_PROD=1（保持 log 短信模式可用）。
# config.validate() 有一条硬规则：DBEE_PROD=1 且 SMS_PROVIDER=log → 拒绝启动。
# 🟢 短信签约已通过（2026-10-27）→ 切真短信时用环境变量一并打开，不必改本文件：
#   SMS_PROVIDER=tencent DBEE_PROD=1 ...（完整命令见下方「短信 / 验证码」段）
# DBEE_PROD=1 连带影响（务必知情）：
#   · 启用开发占位符密钥检查、access token 超 30 天告警
#   · appleSandbox 生产默认关（沙盒收据不再能换真会员）
#   · CORS 未配白名单时**拒绝所有跨域请求**（同源不受影响；deploy-gateway.sh 会提前拦）

# ── 监听 ──────────────────────────────────────────────────────────────
# 只绑回环：公网入口是 nginx（80/443），网关绝不直接暴露。
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080

# ── 密钥（三把，职责互不重叠，轮换其中一个不应连带作废另两个）──────────
# JWT_SECRET：签发/校验会话 token。PostgREST 必须用**同一个值**验签，
#   所以 deploy-postgrest.sh 的 DBEE_JWT_SECRET 要与此处一致。
# IDENT_PEPPER：app_users 身份哈希的 HMAC 胡椒。11 位手机号空间仅 10^11，
#   **没有 PEPPER 就能穷举反查**，所以它不是可选项。且必须 ≠ JWT_SECRET
#   （validate 会拦），否则轮换 JWT 会让全体用户身份失配。
# ⚠️ 两者一经投用**不可再改**：改 JWT_SECRET = 所有人被登出；
#    改 IDENT_PEPPER = app_users 里已存的 ident_hash 全部失效，老用户变新用户。
JWT_SECRET=__JWT_SECRET__
IDENT_PEPPER=__IDENT_PEPPER__

# ── 数据库（本机回环，与 PG 同机）─────────────────────────────────────
DBEE_HOST=127.0.0.1
DBEE_PORT=5432
DBEE_DB=dbee
# 业务面 + 身份面都用 dbee_app。
# 说明：0031 建的 dbee_gateway 是 NOLOGIN（连不上），config.mjs 的
# dbGatewayUser 默认回退到 DBEE_USER，所以身份面实际走 dbee_app；
# 0033 已为它配好 app_users 的专用 policy 与精确表权限，隔离靠**策略**而非靠角色分离。
DBEE_USER=dbee_app
DBEE_PWD=__DBEE_APP_PWD__
# 回环连接不开 TLS（同机 unix 层面无窃听面）。若将来库挪到别的机器，改 1。
DBEE_SSL=0
DBEE_POOL_MAX=10
DBEE_STMT_TIMEOUT_MS=15000

# ── PostgREST 上游（A2 数据面）────────────────────────────────────────
POSTGREST_URL=http://127.0.0.1:3001
# 刻意留空 = 复用 JWT_SECRET（config.mjs 的回退逻辑）。
# 只有想让数据面用独立密钥时才设，且必须与 PostgREST 的 jwt-secret 同步改。
# POSTGREST_JWT_SECRET=
POSTGREST_SCHEMA=public

# ── 短信 / 验证码 ─────────────────────────────────────────────────────
# 可选 log（开发：日志+万能码）、tencent（腾讯云真短信，2026-10-26 已实现）
# 或 aliyun（阿里云真短信，2026-10-29 已实现——模板 SMS_512482436 已审核通过，
# 为**当前生效的真短信通道**；签名口径见下方 SMS_SIGN_NAME 注释）。
# 🟢 切换 aliyun —— **不必手改本文件**，一条命令即可（环境变量覆盖模板值）：
#   SMS_PROVIDER=aliyun DBEE_PROD=1 \
#   SMS_ALIYUN_ACCESS_KEY_ID='...' SMS_ALIYUN_ACCESS_KEY_SECRET='...' \
#   SMS_ALIYUN_TEMPLATE_CODE='SMS_512482436' \
#       bash deploy/deploy-gateway.sh
# deploy-gateway.sh 会自动：注入凭据 → 摘除 SMS_MASTER_CODE 行 → 追加 DBEE_PROD=1
# （凭据持久化到 deploy/gateway/.secrets.local，下次部署不必重传）。
# 下方占位符即由该脚本填充；保持 SMS_PROVIDER=log 时渲染为空值，不影响启动。
# config.validate 会拦住「生产+log」「tencent/aliyun+万能码」等危险组合。
SMS_PROVIDER=log
# 万能码。⚠️ 这是**临时**措施，风险要说清楚：知道它就能登录**任意**账号。
# 缓解措施（已在别处落实，不是只靠"码够长"）：
#   · 用 24 位随机串，穷举不可行；只存在服务器 env 与本地 gitignored 文件里
#   · 正常登录路径其实**不需要它**：log 模式下真实验证码会打进 journald
#     （sms.mjs 第 22 行），有 SSH 权限即可读到，走的是正常 OTP 流程
#   · 发码本身有频率限制：同号 60 秒一次、同 IP 每小时 20 次（OTP_RESEND_SEC/OTP_IP_HOUR_LIMIT）
#   · 单挑战试错上限 5 次，超限锁定（OTP_MAX_ATTEMPTS）
# 采购短信通道后本行由 deploy-gateway.sh **自动摘除**（SMS_PROVIDER=tencent/aliyun 时），
# 无需手动删除；validate 规则「真短信 + 万能码 = 拒启」由脚本代劳。
SMS_MASTER_CODE=__SMS_MASTER_CODE__
# 🔴 签名口径（2026-10-29 实测）：阿里云账号下**唯一审核通过**的签名是「北京迪蜂科技有限公司」
#（QuerySmsSignList API 实查；「自律蜜蜂」不存在于该账号 → SendSms 报 isv.SMS_SIGNATURE_ILLEGAL）。
# 短信将显示为【北京迪蜂科技有限公司】。若想要品牌签名「自律蜜蜂」，须先在阿里云
# 控制台提交签名申请（App 名称类签名需软著/应用市场链接等资质），审核通过后改回：
#   SMS_SIGN_NAME=自律蜜蜂（一条 env 即可切换，无需改代码）
SMS_SIGN_NAME=北京迪蜂科技有限公司
# ── 腾讯云短信凭据（SMS_PROVIDER=tencent 时四项必填）────────────────
# 控制台路径：smsv2.console.tencentcloud.com
#   · SECRET_ID/KEY：访问管理 CAM → API 密钥管理（建议建「短信子账号」最小权限密钥，别用主账号密钥）
#   · SDKAPPID：应用管理 → 创建应用后获得（纯数字 1400xxxxxx）
#   · TEMPLATE_ID：正文模板管理 → 提审模板「您的验证码是{1}，{2}分钟内有效」（审核约 2 小时–2 天）
#   · 签名（SMS_SIGN_NAME）须与控制台已审核通过的签名一致（口径见上方短信段注释）
# 四项占位符由 deploy-gateway.sh 从环境变量或 deploy/gateway/.secrets.local 注入；
# log 模式下渲染为空值即可（validate 只在 tencent 模式校验这四项）。
SMS_TENCENT_SECRET_ID=__SMS_TENCENT_SECRET_ID__
SMS_TENCENT_SECRET_KEY=__SMS_TENCENT_SECRET_KEY__
SMS_TENCENT_SDKAPPID=__SMS_TENCENT_SDKAPPID__
SMS_TENCENT_TEMPLATE_ID=__SMS_TENCENT_TEMPLATE_ID__
SMS_TENCENT_REGION=ap-guangzhou
# ── 阿里云短信凭据（SMS_PROVIDER=aliyun 时三项必填，2026-10-29 审核通过）──
# 控制台路径：dysms.console.aliyun.com
#   · ACCESS_KEY_ID/SECRET：RAM 访问控制 → 用户 → 创建「短信专用」RAM 用户，
#     只授 AliyunDysmsFullAccess（🔴 别用主账号 AccessKey——泄露=整个云账号沦陷）
#   · TEMPLATE_CODE：模板管理 → 已审核通过（SMS_512482436，验证码模板）
#   · 模板正文（2026-10-29 API 实测）：「您的验证码：${code}，您正在进行身份验证，
#     请勿泄露于他人！」——仅 ${code} 一个变量（sms.mjs 的 TemplateParam 已对齐）
# 三项占位符由 deploy-gateway.sh 从环境变量或 deploy/gateway/.secrets.local 注入；
# log/tencent 模式下渲染为空值即可（validate 只在 aliyun 模式校验这三项）。
SMS_ALIYUN_ACCESS_KEY_ID=__SMS_ALIYUN_ACCESS_KEY_ID__
SMS_ALIYUN_ACCESS_KEY_SECRET=__SMS_ALIYUN_ACCESS_KEY_SECRET__
SMS_ALIYUN_TEMPLATE_CODE=__SMS_ALIYUN_TEMPLATE_CODE__
# endpoint 默认国内中心；国际/港澳台短信才需改（如 dysmsapi.ap-southeast-1.aliyuncs.com）
SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SEC=60
OTP_IP_HOUR_LIMIT=20

# ── 邮件通道（email 登录验证码，2026-10-27 新增，与短信解耦）──────────
# WEB 端登录页支持「邮箱」Tab；发码时 email 走 EMAIL_PROVIDER，短信仍走 SMS_PROVIDER。
# EMAIL_PROVIDER=log   验证码进 journald（开发占位，WEB 端收不到真邮件）
# EMAIL_PROVIDER=smtp  通用 SMTP 真发信（零依赖：node:net/node:tls 手写会话，不装 nodemailer）
#
# 当前接的是网易 163 邮箱（smtp.163.com），账号 = dbeeSupport@163.com。
# 🔴 2026-10-27 由 139 邮箱切换到 163：该邮箱同时作为站内公示的联系邮箱
#   （src/content/legal.ts 的 contactEmail），发信与收信同一账号，便于统一维护。
# 四条硬约束：
#   · 🔴 必须走 465（或 994）+ SSL：163 也提供 25 端口，但**云厂商普遍封锁
#     25 端口出站**（防垃圾邮件），腾讯云也不例外 → 用 25 会连接超时。
#     故 EMAIL_SMTP_SECURE=1（走 SMTPS 直连 TLS，不做 STARTTLS 升级）。
#     若 465 不通可改 994（同为 SSL，163 官方备用端口）。
#   · 🔴 PASS 必须是「客户端授权码」而非登录密码：163 邮箱「设置 → POP3/SMTP/IMAP」
#     里开启 IMAP/SMTP 服务后，经短信验证生成的**16 位大写字母**随机串。
#     ⚠️ 授权码**只显示一次**，关掉页面就再也看不到，只能重新生成。
#     用登录密码会被 535 拒。授权码由 deploy-gateway.sh 从
#     deploy/gateway/.secrets.local 注入（不入库）。
#   · 🔴 FROM 必须等于发信账号本身（163 校验 From 与登录身份一致，否则拒信）。
#     所以下面 USER 与 FROM 用同一个占位符，避免两处抄写不一致。
#   · ⚠️ 发信量有上限（网易官方：普通用户 SMTP 每天 ≤450 封，web ≤180 封）。
#     验证码场景够用；若将来量级上来出现 550 MI:STC / 421 HL:IFC（频率超限）
#     或 554 DT:SPM（内容被判垃圾），需换专业发信服务（阿里云邮件推送/SendGrid）
#     —— 本网关是通用 SMTP 实现，换服务商只需改这 6 个变量，代码零改动。
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.163.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=1
EMAIL_SMTP_USER=__EMAIL_SMTP_USER__
EMAIL_SMTP_PASS=__EMAIL_SMTP_PASS__
EMAIL_SMTP_FROM=__EMAIL_SMTP_USER__
EMAIL_SMTP_FROM_NAME=自律蜜蜂

# ── 审核演示账户（App Store 提审用，⑦）──────────────────────────────
# 审核员没有真实手机号，收不到短信 → 会卡在登录页被拒（审核指南 2.1）。
# 方案：指定一个演示手机号 + 一个固定验证码，只对该号生效、且**不真发短信**。
# 安全性（与万能码的本质区别）：
#   · 万能码 = 任何人可登录任何账号（全局后门，生产必须删）
#   · 演示码 = 只解锁 DEMO_PHONE 这一个号，不构成全局后门 → 生产也允许保留
# 使用：提审时在 ASC「App 审核信息」填 DEMO_PHONE + DEMO_CODE 给审核员即可。
# 约束：DEMO_PHONE 与 DEMO_CODE 必须成对配置；DEMO_CODE 不得与 SMS_MASTER_CODE 相同
#   （config.validate 会拦）。留空 = 关闭演示账户，不影响正常登录。
# 示例：DEMO_PHONE=13800000000 / DEMO_CODE=123456
# DEMO_PHONE=
# DEMO_CODE=

# ── LLM（A3）──────────────────────────────────────────────────────────
# ⚠️ 留空则 /.cloud/llm/* 返回 503（config.warnings 会提示，但不阻止启动）。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=__LLM_API_KEY__
# 文本模型：deepseek-flash（deepseek-chat/reasoner 已退役）
LLM_MODEL_TEXT=deepseek-flash
# 视觉模型：接阿里云 MaaS 的 Qwen（视觉精度高于 DeepSeek flash）。
# 🔴 此值必须与生产一致：config.mjs 的回落链是
#   llmVisionModel = LLM_VISION_MODEL || LLM_MODEL_VISION || 'deepseek-flash'
#   生产未配 LLM_VISION_MODEL，模型名全靠这里的 LLM_MODEL_VISION 兜底。
#   改错 = 视觉请求用错模型 ID 打阿里云端点，直接 4xx。
LLM_MODEL_VISION=qwen3-vl-plus
# ── 视觉 provider（独立于上面的文本 provider）─────────────────────────
# 生产口径（2026-11-02 从 /etc/dbee/gateway.env 核对）：
#   BASE_URL/MODEL 非秘密直接写在模板；API_KEY 是秘密，占位符由
#   deploy-gateway.sh 从 deploy/gateway/.secrets.local 注入
#   （回收工具：deploy/fetch-llm-secrets.py）。
# 🔴 BASE_URL 与 API_KEY 必须成对更换：百炼的 API Key 绑定工作空间，
#   只换 key 不换端点 → 403（key 与工作空间不匹配）。同理 MODEL 必须是
#   该工作空间下已开通的模型 ID，否则 404。
#   当前工作空间 ws-eu9wgvc1ysz242kj（2026-11-02 从旧的
#   ws-myumgi46hdb6mu3z 迁移，配套 qwen3.8-max-0902 → qwen3-vl-plus）。
#   单独改这三键请用 deploy/apply-vision-key-update.py（手术式，
#   只动这 3 行 + 红线键指纹断言），别跑 deploy-gateway.sh 整体重渲染。
LLM_VISION_BASE_URL=https://ws-eu9wgvc1ysz242kj.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
LLM_VISION_API_KEY=__LLM_VISION_API_KEY__
LLM_VISION_MODEL=
# 图片 detail：high=保留原图（食物识别需看清细节，默认），low=缩到 512 级省 token
LLM_IMAGE_DETAIL=high
LLM_TIMEOUT_MS=120000
# 🔴 视觉请求是否开启上游「深度思考」。默认 false（关）。
#   2026-11-01 生产实测：qwen3.8-max 默认开思考，一单午餐识别 completion=3221 token
#   其中 reasoning=3105（96% 空转），单次耗时 30–60s+（用户报「识别超过 1 分钟」）。
#   看图报菜名不需要推理链，关掉后延迟与成本双降。
#   仅对阿里云百炼 Qwen3.x 生效；DeepSeek 上游会忽略该参数。
LLM_VISION_ENABLE_THINKING=false
LLM_DAILY_CAP=200
# 🔴 安全审计③：文本请求独立日限额（默认 50）。
#   文本不经过 llm_gate 业务额度（产品口径仅拍照计费），若不独立降额，
#   等于向用户开放「200 次/日的免费通用 LLM 代理」。20–50 已足够轻量交互。
LLM_TEXT_DAILY_CAP=50
# ── LLM 服务端授权与输入限制（0039，以下均有默认值，通常无需设置）──────
# LLM_GATE_ENABLED=1        视觉请求权益闸门，生产必须为 true（默认即 true）
# LLM_PACKAGE_DAILY_CAP=8   包装识别（条码兜底，不占拍照额度）每用户每日视觉上限
# LLM_MAX_INPUT_TOKENS=32000  单请求估算 token 上限
# LLM_MAX_IMAGES=4          单请求图片数上限
# LLM_MAX_MESSAGES=60       单请求消息条数上限
# LLM_MAX_CONCURRENT_STREAMS=32  全进程同时在途流式请求上限，超限 429

# ── 微信小程序登录凭据（A3，2026-11-05，/v1/login-wechat）───────────────
# 小程序端唯一原生登录通道：wx.login() → code → POST /v1/login-wechat，
# 网关用 appid+secret 调微信 jscode2session 换 openid。未配置 → 端点返回 503
# （config.warnings 会提示，不阻止启动）。
# 🔴 试用与正式是**两套独立小程序**（各有独立 appid + AppSecret），故支持多组：
#   WECHAT_MINI_SECRETS="wxAAA=secretA,wxBBB=secretB"（appid=secret，逗号分隔）
# 单组简写 WECHAT_APPID + WECHAT_SECRET 也收，与多组合并进同一张表。
# AppSecret 在微信公众平台「开发管理→开发设置」查看（32 位 hex，只显示一次）。
# ⚠️ 凭据只进本文件渲染产物 / deploy/gateway/.secrets.local，**不入库**。
# 🔴 别与短信的 SMS_TENCENT_SDKAPPID 混淆 —— 那是腾讯云短信 SDKAppID（纯数字），
#   这里的 WECHAT_APPID 是微信小程序 appid（wx 开头）。
# WECHAT_MINI_SECRETS=__WECHAT_MINI_SECRETS__
# WECHAT_APPID=__WECHAT_APPID__
# WECHAT_SECRET=__WECHAT_SECRET__
# jscode2session 端点与超时（通常无需改；WECHAT_API_BASE 可覆盖仅供自测 mock）
WECHAT_API_BASE=https://api.weixin.qq.com
WECHAT_TIMEOUT_MS=10000

# ── 前端应用标识 ──────────────────────────────────────────────────────
# src/cloudConfig.ts 里的 wbpk_… publishableKey。自托管下它只是应用标识，
# 不承担安全职责（真密钥是 JWT_SECRET）；留空则跳过 access-key 校验。
WB_PUBLISHABLE_KEY=__WB_PUBLISHABLE_KEY__

# ── Apple IAP（C1，iOS 上架前才需要）──────────────────────────────────
# 留空则验签端点返回 503，不影响其他功能。
# APPLE_BUNDLE_ID=
# APPLE_SHARED_SECRET=
# APPLE_SANDBOX=1
# APPLE_WEBHOOK_SECRET=
# 🔴 收据/通知环境白名单（0039）：防沙盒假钱收据在生产换走真会员。
#   默认按 APPLE_SANDBOX 推导：提审期(=1)双环境都收，上架后(=0)只收 Production。
#   仅在需要临时打破该口径时才显式设置，例如：
#   APPLE_ALLOWED_ENVS=Sandbox,Production
#   上架切换动作 = 把 APPLE_SANDBOX 改为 0（白名单自动收紧为 Production）。

# ── 小程序虚拟支付 xpay（0046 / server/lib/xpay.mjs）──────────────────────
# 🔴 当前状态（2026-11-12，P0.4 补登记）：**全部关闭**。
#   · 构建期开关 D_BEE_XPAY_ENABLED 默认 false（mini 与 Web 引导同用一个变量）；
#   · 开启前置 6 项见 mini/src/lib/xpayEnabled.ts 文件头 —— **先配平台再开开关**；
#   · 0046 迁移未应用生产，此时开开关会直接失效（见 tools/release-readiness.baseline.json）。
#   本段只登记 **key 名**，全部保持注释态；真实凭据只进 /etc/dbee/gateway.env，
#   不入库、不进日志、不下发前端、不写进仓库。
#   xpay 走米大师（微信虚拟支付），与下面 Android APP 支付是**两套互不复用**的商户体系。
#
# ── 米大师 / 微信虚拟支付签约信息（4 项齐备才算「已配置」）───────────────
# XPAY_OFFER_ID=           # 米大师道具 Offer ID（微信公众平台虚拟支付签约后取得）
# XPAY_APP_KEY=            # 米大师 AppKey（签算 signData 用；🔴 signData 必须原样透传）
# XPAY_PUSH_TOKEN=         # 发货推送 Token（补权益后必须调 /xpay/notify_provide_goods，否则资金不结算）
# XPAY_PUSH_AES_KEY=       # 发货推送 AES 密钥
#
# ── 会话解密（xpay 与 mini 登录共用）─────────────────────────────────────
# WECHAT_SESSION_ENC_KEY=  # 微信 session_key 加密密钥；缺失时 xpay 相关端点返回 503
#
# 🔴 资损铁律（开启前必读）：推送丢失后补权益**必须**调 /xpay/notify_provide_goods；
#    已扣款未确认一律 settling，**绝不报 error**；道具直购**不自动续费**，
#    不得照抄 iOS「24 小时续订」文案（虚假宣传）。

# ── Android APP 支付（0047 / server/lib/apppay.mjs）──────────────────────
# 🔴 用户定案（2026-11-09）：Android 端必须能收款；Web 暂不收费只做引导；四端业务逻辑不变。
#   本段是 Android 收款的**服务端凭据**（微信 APP 支付 V3 + 支付宝 App 支付 RSA2）。
#   与小程序虚拟支付 xpay（米大师）并列两套商户体系，互不复用。
#   未配齐某渠道 → prepay/notify 对**该渠道**返回 503（同 IAP/xpay notConfigured 模式），
#   不影响另一渠道。全部凭据只进 /etc/dbee/gateway.env 或 .secrets.local，**不入库、不进日志、不下发前端**。
#   前端要真正拉起支付按钮，还须构建期开 D_BEE_APPPAY_ENABLED=true（见根 .env.example）。
#
# 回调通知公网基础 URL：微信/支付宝 notify_url 必须是平台可回达的 https 绝对地址。
#   默认 https://d-bee.cn（四端同源）。灰度域名才覆盖。**不含末尾斜杠**。
# PUBLIC_BASE_URL=https://d-bee.cn
#
# ── 微信 APP 支付（普通商户号，V3）——5 项齐备才算「已配置」──────────────
# WECHAT_PAY_APPID=            # 微信开放平台「移动应用」AppID（非小程序 appid）
# WECHAT_PAY_MCHID=            # 微信支付商户号
# WECHAT_PAY_SERIAL_NO=        # 商户 API 证书序列号（apiclient_cert.pem 对应）
# WECHAT_PAY_PRIVATE_KEY=      # 商户 API 私钥 PKCS#8 PEM；单行写法用 \n 转义换行
# WECHAT_PAY_APIV3_KEY=        # APIv3 密钥，**必须 32 字节**（回调 AES-256-GCM 解密）
# WECHAT_PAY_PLATFORM_CERT=    # 🔴 微信支付平台证书公钥 PEM（验回调签名）。缺失→回调验签必失败→拒发权益
#
# ── 支付宝 App 支付（RSA2 = SHA256withRSA）——3 项齐备才算「已配置」──────
# ALIPAY_APP_ID=               # 支付宝开放平台应用 AppID
# ALIPAY_PRIVATE_KEY=          # 应用私钥 PKCS#8；单行写法用 \n 转义换行
# ALIPAY_PUBLIC_KEY=           # 支付宝公钥（验异步通知签名；不是应用公钥）

# ── 限流 ──────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MIN=300
BODY_LIMIT_BYTES=33554432
# 🔴 XFF 可信代理白名单（0039）：X-Forwarded-For 可被客户端伪造，
#   仅当直连对端可信（回环，或列在此处）时才解析 XFF 取真实客户端 IP。
#   回环地址天然可信 —— 当前「网关只绑 127.0.0.1、nginx 同机」的部署**无需设置**。
#   只有网关与 nginx 分机部署时，才把 nginx 的内网 IP 填进来（逗号分隔）：
#   TRUSTED_PROXY_IPS=10.0.0.5

# ── CORS 来源白名单（安全审计⑦）──────────────────────────────────────
# 🔴 此前网关无条件回显请求里的 Origin，等于向任意网站开放跨域请求。
#   现在改为白名单：仅命中此处的 Origin 才回显 allow-origin，其余跨域请求
#   浏览器侧会被阻断（不返回 allow-origin 头）。
#   · 生产（DBEE_PROD=1）：必须配，否则所有跨域请求被拒（同源不受影响）。
#   · 非生产：未配则回显任意 Origin（开发便利，与旧行为一致）。
#   支持精确域名与通配子域，逗号分隔，例如：
#   CORS_ALLOWED_ORIGINS=https://dbee.example.com,https://*.dbee.example.com
#   ⚠️ 域名就绪后（HTTPS 上架硬阻断项之一），把对外站点地址填进来。
#   📌 双域名规划（2026-10-28）落地时的推荐值：
#   CORS_ALLOWED_ORIGINS=https://d-bee.cn,https://www.d-bee.cn,capacitor://localhost,https://localhost
#   （Web 端 = d-bee.cn；官网 d-bee.com.cn 是纯静态站、不调网关，无需入白名单）
# CORS_ALLOWED_ORIGINS=
